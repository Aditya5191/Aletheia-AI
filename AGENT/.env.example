# Lustitia Agentic Bias Detector - Environment Variables

# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MCP Server URL (required for live algorithm fetching, otherwise falls back)
MCP_SERVER_URL=http://your-mcp-server:port/sse

# Docker Image for Sandbox (optional)
# Default: ghcr.io/vndee/sandbox-python-311-bullseye
SANDBOX_IMAGE=ghcr.io/vndee/sandbox-python-311-bullseye
