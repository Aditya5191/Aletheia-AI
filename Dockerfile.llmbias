FROM python:3.11-slim

# Install Docker CLI only (needed to spawn sandbox containers on the host, though BiasProbe might not need it, kept for consistency)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies (from both main and biasprobe)
COPY requirements.txt .
COPY biasprobe/requirements.txt biasprobe_requirements.txt
RUN pip install --no-cache-dir -r requirements.txt -r biasprobe_requirements.txt

# Copy application code
COPY backend/ backend/
COPY biasprobe/ biasprobe/
COPY mcps/ mcps/
COPY .env .env
COPY .secrets/ .secrets/

# Create required directories
RUN mkdir -p biasprobe_outputs

EXPOSE 8007

# Start the FastAPI backend
CMD ["uvicorn", "backend.biasprobe_backend.backend.api:app", "--host", "0.0.0.0", "--port", "8007"]
