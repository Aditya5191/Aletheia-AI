# ── Deployment mode ────────────────────────────────────────────────────────────
# "local"  → spawns all MCP servers as subprocesses, uses localhost URLs
# "prod"   → skips spawning, connects to the dedicated URLs below
DEPLOY_ENV=local

# ── Google / Vertex AI credentials ────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=.secrets/vertex-credentials.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ── Backend API ────────────────────────────────────────────────────────────────
BACKEND_PORT=8005

# ── MCP server ports (local mode only) ────────────────────────────────────────
SANDBOX_MCP_PORT=8000
AUDITOR_MCP_PORT=8001
MISC_MCP_PORT=8002

# ── MCP dedicated URLs (prod mode only) ───────────────────────────────────────
SANDBOX_MCP_URL=https://your-sandbox-mcp.example.com/sse
AUDITOR_MCP_URL=http://localhost:8001/sse
MISC_MCP_URL=https://your-misc-mcp.example.com/sse
